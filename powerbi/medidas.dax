// GABARITO - EXERCÍCIO 10 - Aurora Eletro: medidas DAX (uso do instrutor)

Faturamento = SUM ( fato_vendas[valor_liquido] )

Qtd Vendas = COUNTROWS ( fato_vendas )

Ticket Médio = DIVIDE ( [Faturamento], [Qtd Vendas] )

Margem = [Faturamento] - SUM ( fato_vendas[custo_total] )

Margem % = DIVIDE ( [Margem], [Faturamento] )

Meta = SUM ( fato_metas[meta_faturamento] )

% Atingimento = DIVIDE ( [Faturamento], [Meta] )

Faturamento Ano Anterior =
CALCULATE ( [Faturamento], SAMEPERIODLASTYEAR ( dim_calendario[data] ) )

Crescimento % =
DIVIDE ( [Faturamento] - [Faturamento Ano Anterior], [Faturamento Ano Anterior] )

// Extra: faturamento das vendas com cliente não identificado
Faturamento Sem Cliente =
CALCULATE ( [Faturamento], dim_cliente[sk_cliente] = 0 )
